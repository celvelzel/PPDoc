<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.majy.ppdocapi.mapper.DocumentMapper">
    <update id="update" parameterType="com.majy.ppdocapi.entity.po.Document">
        update document
        <set>
            <if test="document_url != null">
                document_url = #{document_url},
            </if>
            <if test="document_ocr_url != null">
                document_ocr_url = #{document_ocr_url},
            </if>
            <if test="document_name != null">
                document_name = #{document_name},
            </if>
            <if test="document_type != null">
                document_type = #{document_type},
            </if>
            <if test="all_info != null">
                all_info = #{all_info},
            </if>
        </set>
        where document_id = #{document_id}
    </update>
</mapper>
